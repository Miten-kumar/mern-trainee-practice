{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",

    "rootDir": ".",
    "outDir": "dist",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "types": [
      "node",
      "jest"
    ]
  },

  "include": [
    "src",
    "prisma",
    "tests",
    "jest.config.ts"
  ],

  "exclude": [
    "node_modules",
    "dist"
  ]
}